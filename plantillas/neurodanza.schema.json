{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "neurodanza.config.json",
  "type": "object",
  "required": [
    "repos"
  ],
  "properties": {
    "repos": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "nombre",
          "ruta"
        ],
        "properties": {
          "nombre": {
            "type": "string"
          },
          "ruta": {
            "type": "string"
          },
          "codigo": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "ignorar": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "lintGlobs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "lint": {
            "type": "string",
            "description": "Usa {archivos} para la lista de archivos."
          },
          "tipos": {
            "type": "string"
          },
          "relacionadas": {
            "type": "string",
            "description": "Usa {archivos}."
          },
          "sinPruebas": {
            "type": "string"
          },
          "suite": {
            "type": "string",
            "description": "Suite completa del repo: corre en segundo plano (lib/fondo.mjs)."
          }
        }
      }
    },
    "barreras": {
      "type": "object",
      "properties": {
        "timeoutComandos": {
          "type": "object",
          "properties": {
            "activo": {
              "type": "boolean"
            },
            "maxSeg": {
              "type": "integer",
              "minimum": 1,
              "maximum": 600
            },
            "largos": {
              "type": "array",
              "items": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "object",
                    "required": [
                      "patron"
                    ],
                    "properties": {
                      "patron": {
                        "type": "string"
                      },
                      "tipo": {
                        "enum": [
                          "servidor",
                          "watch",
                          "suite",
                          "largo"
                        ]
                      }
                    }
                  }
                ]
              }
            }
          }
        }
      }
    },
    "retroalimentacion": {
      "type": "object",
      "properties": {
        "topeStopSeg": {
          "type": "integer",
          "minimum": 10,
          "maximum": 110,
          "description": "Tope en segundos de la parte que bloquea del hook Stop; lo que no alcanza pasa al fondo."
        },
        "topeFondoSeg": {
          "type": "integer",
          "minimum": 60,
          "description": "Tope en segundos de cada tarea en segundo plano."
        }
      }
    },
    "reglas": {
      "type": "object",
      "properties": {
        "coherencia": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "permisos": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "ui": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "docs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "app": {
      "type": "object"
    },
    "roles": {
      "type": "object",
      "properties": {
        "adaptador": {
          "enum": [
            "json",
            "markdown"
          ]
        },
        "fuente": {
          "type": "string"
        }
      }
    },
    "panel": {
      "type": "object",
      "properties": {
        "min": {
          "type": "integer",
          "minimum": 1
        },
        "max": {
          "type": "integer",
          "minimum": 1
        },
        "umbral": {
          "type": "number"
        },
        "maxRondas": {
          "type": "integer"
        },
        "ventana": {
          "enum": [
            "windows",
            "ninguna"
          ]
        }
      }
    },
    "evals": {
      "type": "object"
    },
    "errores": {
      "type": "object",
      "properties": {
        "activo": {
          "type": "boolean"
        },
        "archivo": {
          "type": "string",
          "description": "Catálogo de errores conocidos (se versiona)."
        },
        "alIniciar": {
          "type": "integer",
          "minimum": 0,
          "description": "Cuántos se cargan como contexto al iniciar la sesión."
        }
      }
    },
    "director": {
      "type": "object",
      "properties": {
        "worktrees": {
          "type": "string",
          "description": "\"auto\" (por defecto) o carpeta de los worktrees; admite {proyecto}."
        },
        "enlazar": {
          "type": "array",
          "items": {
            "enum": [
              "node_modules"
            ]
          }
        },
        "rebobinar": {
          "type": "object",
          "properties": {
            "activo": {
              "type": "boolean"
            },
            "umbralCorreccion": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "Fracción del diff original a partir de la cual corregir encima deja de convenir."
            },
            "maxMuertes": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "ciclo": {
      "type": "object",
      "properties": {
        "plan": {
          "type": "string"
        },
        "maxPasos": {
          "type": "object",
          "properties": {
            "revisor": {
              "type": "integer"
            },
            "persona": {
              "type": "integer"
            },
            "implementador": {
              "type": "integer"
            },
            "otro": {
              "type": "integer"
            }
          }
        },
        "revisores": {
          "enum": [
            "segun-cambio",
            "todos"
          ]
        },
        "maxSegundos": {
          "type": "object",
          "description": "Tope de tiempo por tipo de subagente (s): aviso al 80 %, rechazo al 100 %.",
          "properties": {
            "revisor": {
              "type": "number"
            },
            "persona": {
              "type": "number"
            },
            "implementador": {
              "type": "number"
            },
            "otro": {
              "type": "number"
            }
          }
        },
        "latidoSeg": {
          "type": "number",
          "description": "Segundos sin un paso para marcar a un subagente sin latido."
        }
      }
    },
    "constructos": {
      "type": "object",
      "properties": {
        "carpeta": {
          "type": "string",
          "description": "Datos locales de los constructos (no se versiona)."
        },
        "minEvidencias": {
          "type": "integer",
          "minimum": 1
        },
        "ciclosPrueba": {
          "type": "integer",
          "minimum": 1
        },
        "maxLecciones": {
          "type": "integer",
          "minimum": 1
        },
        "automatico": {
          "type": "boolean"
        },
        "compartido": {
          "type": "string",
          "description": "auto | local | carpeta donde se versionan las lecciones aprobadas."
        }
      }
    },
    "autoconfigurar": {
      "type": "boolean",
      "description": "Al iniciar la sesión: .gitignore de la raíz y aviso de permisos de los worktrees."
    },
    "fusible": {
      "type": "object",
      "properties": {
        "maxFallos": {
          "type": "integer",
          "minimum": 1,
          "description": "Fallos de una capa en el ciclo para fundirla."
        },
        "comprobaciones": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "{ capa: comando } que dice si la capa responde (p. ej. bd)."
        }
      }
    },
    "pilas": {
      "type": "object",
      "properties": {
        "activo": {
          "type": "boolean"
        },
        "avanceCada": {
          "type": "integer",
          "minimum": 0,
          "description": "Cada cuántos pasos se le pide al subagente su línea de avance (0 = nunca)."
        }
      }
    },
    "figuras": {
      "type": "object",
      "properties": {
        "activo": {
          "type": "boolean"
        },
        "cuarentena": {
          "type": "integer",
          "minimum": 1
        },
        "manos": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "enum": [
                "leer",
                "editar",
                "verificar",
                "externo",
                "destructivo",
                "red-app"
              ]
            }
          },
          "description": "Manos por tipo de agente (revisor, persona, implementador, fantasma, principal, otro)."
        }
      }
    }
  }
}
