{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "neurodanza.config.json",
  "type": "object",
  "required": [
    "repos"
  ],
  "properties": {
    "repos": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "nombre",
          "ruta"
        ],
        "properties": {
          "nombre": {
            "type": "string"
          },
          "ruta": {
            "type": "string"
          },
          "codigo": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "ignorar": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "lintGlobs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "lint": {
            "type": "string",
            "description": "Usa {archivos} para la lista de archivos."
          },
          "tipos": {
            "type": "string"
          },
          "relacionadas": {
            "type": "string",
            "description": "Usa {archivos}."
          },
          "sinPruebas": {
            "type": "string"
          },
          "suite": {
            "type": "string",
            "description": "Suite completa del repo: corre en segundo plano (lib/fondo.mjs)."
          }
        }
      }
    },
    "barreras": {
      "type": "object",
      "properties": {
        "comentarios": {
          "enum": [false, "basura", "estricto"],
          "description": "Comentarios nuevos en JS/TS que se rechazan al editar: basura (código comentado, TODO sin ticket) o estricto (solo directivas, JSDoc con etiquetas de lo exportado y // POR QUÉ: …)."
        },
        "timeoutComandos": {
          "type": "object",
          "properties": {
            "activo": {
              "type": "boolean"
            },
            "maxSeg": {
              "type": "integer",
              "minimum": 1,
              "maximum": 600
            },
            "largos": {
              "type": "array",
              "items": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "object",
                    "required": [
                      "patron"
                    ],
                    "properties": {
                      "patron": {
                        "type": "string"
                      },
                      "tipo": {
                        "enum": [
                          "servidor",
                          "watch",
                          "suite",
                          "largo"
                        ]
                      }
                    }
                  }
                ]
              }
            }
          }
        }
      }
    },
    "retroalimentacion": {
      "type": "object",
      "properties": {
        "topeStopSeg": {
          "type": "integer",
          "minimum": 10,
          "maximum": 110,
          "description": "Tope en segundos de la parte que bloquea del hook Stop; lo que no alcanza pasa al fondo."
        },
        "topeFondoSeg": {
          "type": "integer",
          "minimum": 60,
          "description": "Tope en segundos de cada tarea en segundo plano."
        }
      }
    },
    "reglas": {
      "type": "object",
      "properties": {
        "coherencia": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "permisos": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "ui": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "docs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "app": {
      "type": "object"
    },
    "roles": {
      "type": "object",
      "properties": {
        "adaptador": {
          "enum": [
            "json",
            "markdown"
          ]
        },
        "fuente": {
          "type": "string"
        }
      }
    },
    "panel": {
      "type": "object",
      "properties": {
        "min": {
          "type": "integer",
          "minimum": 1
        },
        "max": {
          "type": "integer",
          "minimum": 1
        },
        "umbral": {
          "type": "number"
        },
        "maxRondas": {
          "type": "integer"
        },
        "ventana": {
          "enum": [
            "windows",
            "ninguna"
          ]
        },
        "recorridos": {
          "type": "string",
          "description": "Carpeta de los recorridos permanentes (en git), con id estable."
        },
        "notaMaxSiFalla": {
          "type": "number",
          "minimum": 1,
          "maximum": 10,
          "description": "Nota máxima de una persona si un paso crítico de su recorrido no cumple."
        },
        "memoria": {
          "type": "string",
          "description": "Carpeta de la memoria por recorrido (historial por versión, en git)."
        },
        "regresion": {
          "type": "object",
          "properties": {
            "clics": {
              "type": "integer",
              "minimum": 1
            },
            "tiempo": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "description": "Umbrales de regresión de experiencia contra la última versión aprobada."
        },
        "exploracionPasos": {
          "type": "integer",
          "minimum": 0,
          "description": "Pasos máximos de exploración libre de cada persona tras su recorrido, solo en pantallas del diff."
        },
        "carga": {
          "type": "object",
          "properties": {
            "maxSeg": { "type": "number", "exclusiveMinimum": 0, "description": "Tope de espera antes de cada captura." },
            "quietoMs": { "type": "integer", "minimum": 0, "description": "Milisegundos sin cambios en el DOM para dar la pantalla por cargada." },
            "cargando": { "type": "array", "items": { "type": "string", "minLength": 1 }, "description": "Selectores CSS de carga propios de la app (se suman a los comunes)." }
          },
          "description": "Espera de carga antes de las capturas del panel."
        }
      }
    },
    "evals": {
      "type": "object"
    },
    "errores": {
      "type": "object",
      "properties": {
        "activo": {
          "type": "boolean"
        },
        "archivo": {
          "type": "string",
          "description": "Catálogo de errores conocidos (se versiona)."
        },
        "alIniciar": {
          "type": "integer",
          "minimum": 0,
          "description": "Cuántos se cargan como contexto al iniciar la sesión."
        }
      }
    },
    "director": {
      "type": "object",
      "properties": {
        "worktrees": {
          "type": "string",
          "description": "\"auto\" (por defecto) o carpeta de los worktrees; admite {proyecto}."
        },
        "enlazar": {
          "type": "array",
          "items": {
            "enum": [
              "node_modules"
            ]
          }
        },
        "rebobinar": {
          "type": "object",
          "properties": {
            "activo": {
              "type": "boolean"
            },
            "umbralCorreccion": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "Fracción del diff original a partir de la cual corregir encima deja de convenir."
            },
            "maxMuertes": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "ciclo": {
      "type": "object",
      "properties": {
        "plan": {
          "type": "string"
        },
        "maxPasos": {
          "type": "object",
          "properties": {
            "revisor": {
              "type": "integer"
            },
            "persona": {
              "type": "integer"
            },
            "implementador": {
              "type": "integer"
            },
            "otro": {
              "type": "integer"
            }
          }
        },
        "revisores": {
          "enum": [
            "segun-cambio",
            "todos"
          ]
        },
        "maxSegundos": {
          "type": "object",
          "description": "Tope de tiempo por tipo de subagente (s): aviso al 80 %, rechazo al 100 %.",
          "properties": {
            "revisor": {
              "type": "number"
            },
            "persona": {
              "type": "number"
            },
            "implementador": {
              "type": "number"
            },
            "otro": {
              "type": "number"
            }
          }
        },
        "latidoSeg": {
          "type": "number",
          "description": "Segundos sin un paso para marcar a un subagente sin latido."
        },
        "pruebaPrimero": {
          "enum": [false, "avisar", "exigir"],
          "description": "Si una prueba nueva o cambiada no se vio en rojo antes de implementar: el Stop avisa o bloquea."
        },
        "riesgo": {
          "type": "object",
          "description": "Proporcionalidad: bajo = lint, tipos y pruebas; medio = 1 revisor y 1 persona; alto = ciclo completo.",
          "properties": {
            "activo": { "type": "boolean" },
            "lineasBajo": { "type": "integer", "minimum": 0, "description": "Hasta estas líneas en un repo, sin contratos ni archivos sensibles: riesgo bajo." },
            "lineasAlto": { "type": "integer", "description": "Más de estas líneas: riesgo alto." },
            "altos": { "type": "array", "items": { "type": "string" }, "description": "Globs de archivos sensibles (permisos, auth, migraciones…): riesgo alto. No aplican al repo de docs, a la documentación ni a las pruebas." },
            "permisosEnCodigo": { "oneOf": [{ "type": "string", "minLength": 1 }, { "const": false }], "description": "Expresión regular: si las líneas cambiadas del código coinciden, el cambio es al menos medio y entra el revisor de permisos. false = no mirar el contenido." }
          }
        }
      }
    },
    "constructos": {
      "type": "object",
      "properties": {
        "carpeta": {
          "type": "string",
          "description": "Datos locales de los constructos (no se versiona)."
        },
        "minEvidencias": {
          "type": "integer",
          "minimum": 1
        },
        "ciclosPrueba": {
          "type": "integer",
          "minimum": 1
        },
        "maxLecciones": {
          "type": "integer",
          "minimum": 1
        },
        "automatico": {
          "type": "boolean"
        },
        "compartido": {
          "type": "string",
          "description": "auto | local | carpeta donde se versionan las lecciones aprobadas."
        }
      }
    },
    "autoconfigurar": {
      "type": "boolean",
      "description": "Al iniciar la sesión: .gitignore de la raíz y aviso de permisos de los worktrees."
    },
    "fusible": {
      "type": "object",
      "properties": {
        "maxFallos": {
          "type": "integer",
          "minimum": 1,
          "description": "Fallos de una capa en el ciclo para fundirla."
        },
        "comprobaciones": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "{ capa: comando } que dice si la capa responde (p. ej. bd)."
        }
      }
    },
    "pilas": {
      "type": "object",
      "properties": {
        "activo": {
          "type": "boolean"
        },
        "avanceCada": {
          "type": "integer",
          "minimum": 0,
          "description": "Cada cuántos pasos se le pide al subagente su línea de avance (0 = nunca)."
        }
      }
    },
    "figuras": {
      "type": "object",
      "properties": {
        "activo": {
          "type": "boolean"
        },
        "cuarentena": {
          "type": "integer",
          "minimum": 1
        },
        "manos": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "enum": [
                "leer",
                "editar",
                "verificar",
                "externo",
                "destructivo",
                "red-app"
              ]
            }
          },
          "description": "Manos por tipo de agente (revisor, persona, implementador, fantasma, principal, otro)."
        }
      }
    },
    "fantasmas": {
      "type": "object",
      "properties": {
        "activo": {
          "type": "boolean"
        },
        "hosts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "max": {
          "type": "integer",
          "minimum": 0
        },
        "maxPasos": {
          "type": "integer",
          "minimum": 1
        },
        "maxSegundos": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "login": {
          "type": "object",
          "description": "Cómo entra una persona por API (url, cuerpo con {email} y {clave}, token)."
        }
      }
    },
    "cli": {
      "type": "object",
      "description": "CLI de la app (lib/app.mjs): sesiones en caché y macros que nacen de los comandos repetidos.",
      "properties": {
        "activo": { "type": "boolean" },
        "macros": { "type": "string", "description": "Archivo de las macros del proyecto (en git)." },
        "repetidoMin": { "type": "integer", "minimum": 20, "description": "Caracteres desde los que un comando cuenta como largo." },
        "repetidoVeces": { "type": "integer", "minimum": 2, "description": "Repeticiones para proponerlo como macro." },
        "podarDias": { "type": "number", "description": "Días sin uso para proponer borrar una macro." },
        "sesionMin": { "type": "number", "description": "Minutos que vale una sesión en caché." }
      }
    },
    "indice": {
      "type": "object",
      "description": "Índice pre-cocido por commit (lib/indice.mjs): resumen enfocado para contratos y mensajes de subagentes.",
      "properties": {
        "activo": {
          "type": "boolean"
        },
        "maxLineas": {
          "type": "integer",
          "minimum": 5
        }
      }
    },
    "hotel": {
      "type": "object",
      "description": "Especialistas que el director consulta antes de delegar (lib/hotel.mjs).",
      "properties": {
        "activo": {
          "type": "boolean"
        },
        "maxPasos": {
          "type": "integer",
          "minimum": 1
        },
        "maxSegundos": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "maxPorTarea": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
