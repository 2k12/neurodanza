{
  "repos": [
    {
      "nombre": "api",
      "ruta": "api",
      "codigo": ["src/**"],
      "lint": "node ../herramientas/tarea.mjs --nombre lint --ms 400 {archivos}",
      "tipos": "node ../herramientas/tarea.mjs --nombre tipos --ms 900",
      "relacionadas": "node ../herramientas/tarea.mjs --nombre pruebas --ms 1000 --colgable {archivos}",
      "suite": "node ../herramientas/tarea.mjs --nombre suite --ms 30000"
    },
    {
      "nombre": "web",
      "ruta": "web",
      "codigo": ["src/**"],
      "lint": "node ../herramientas/tarea.mjs --nombre lint --ms 300 {archivos}",
      "tipos": "node ../herramientas/tarea.mjs --nombre tipos --ms 700",
      "relacionadas": "node ../herramientas/tarea.mjs --nombre pruebas --ms 600 {archivos}"
    }
  ],
  "app": { "urls": ["http://localhost:47613"], "levantar": "node servidor.mjs", "login": { "ruta": "/login" } },
  "panel": { "maxRondas": 3, "ventana": "ninguna" },
  "ciclo": { "maxSegundos": { "revisor": 20, "persona": 30, "implementador": 60, "otro": 30 }, "latidoSeg": 8 },
  "autoconfigurar": false
}
